# Runtime environment
NODE_ENV=development
PORT=4000

# MongoDB connection
# Replace this with your local MongoDB or MongoDB Atlas connection string.
MONGODB_URI=mongodb://username:password@localhost:27017/operations-workspace?authSource=admin

# Authentication
# Use a long, unique value outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1w

# Frontend origin allowed by the API
CORS_ORIGIN=http://localhost:5173
